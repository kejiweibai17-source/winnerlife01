# Production site URL (required for correct canonical / JSON-LD / sitemap)
NEXT_PUBLIC_SITE_URL=https://okprime.winnerlife.com

# Resend — contact form email delivery
# Create key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a verified Resend domain (winnerlife.com)
RESEND_FROM_EMAIL=忠訓地產 <noreply@winnerlife.com>
# Inbox that receives form submissions
CONTACT_TO_EMAIL=service@winnerlife.com
# Set to false to temporarily disable all form emails
CONTACT_EMAIL_ENABLED=true
